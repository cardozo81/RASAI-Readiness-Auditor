# Local Python/runtime artifacts
.venv/
.venv-backup-*/
__pycache__/
*.py[cod]
*.egg-info/

# Local audit outputs
audits/

# Licensed/managed MaxMind databases: local to RASAi, never committed
data/geoip/

# Interactive console user configuration (machine/user-specific)
rasai-console.ini
rasai-console.ini.tmp
searchgeo-console.ini
searchgeo-console.ini.tmp

# Local secrets and environment overlays. Secret-free examples remain versionable.
.env
.env.local
.env.*
!.env.example
!.env.*.example

# Common local secret material
*.private.key
*.private.pem
secrets/
.secret/

# Common local tooling
.pytest_cache/
.coverage

# Managed RASAi runtime state (machine-specific, never versioned)
.rasai-runtime/
