# Build only from a reviewed checkout; this image contains the offline renderer.
# Chromium network isolation is supplied by docker run --network none, NOT here.
FROM python:3.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app
# The application supplies a SHA-256 of the reviewed worker source, not a
# version inferred from a mutable Docker tag or release number.
ARG RASAI_ARCHITECTURE_SOURCE_SHA256
LABEL org.rasai.architecture.source-sha256="${RASAI_ARCHITECTURE_SOURCE_SHA256}"
COPY pyproject.toml /app/
COPY src/ /app/src/
RUN python -m pip install --no-cache-dir . \
    && python -m playwright install --with-deps chromium \
    && chmod -R a+rX /ms-playwright /app
RUN useradd --system --uid 10001 --user-group --create-home sandboxuser
USER 10001:10001
ENTRYPOINT ["python", "-m", "rasai.architecture_offline_worker"]
